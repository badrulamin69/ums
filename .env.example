# ==================== Database ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_university?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=1234

# ==================== JWT ====================
JWT_SECRET=change-this-to-a-256-bit-secret-key-in-production-now
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ==================== Server ====================
SERVER_PORT=8085

# ==================== Socket.IO ====================
SOCKETIO_PORT=9090
SOCKETIO_HOST=0.0.0.0

# ==================== SMTP Email ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ==================== SSLCommerz ====================
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ==================== File Upload ====================
UPLOAD_DIR=

# ==================== Frontend ====================
FRONTEND_URL=http://localhost:4200
