# Required environment variables for Smart University Management System
# Copy this file to .env and fill in actual values.

# Database
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT
# Generate a random secret (32+ bytes). Example: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# SMTP (Gmail)
# Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_USERNAME=your_gmail_username
SMTP_PASSWORD=your_gmail_app_password

# SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_SANDBOX=true

# Frontend URL
FRONTEND_URL=http://localhost:4200

# Backend URL (used for SSLCommerz callback URLs)
BACKEND_URL=http://localhost:8085

# Upload directory
UPLOAD_DIR=D:/ensarkbank/uploads

# Socket.IO
SOCKETIO_PORT=9090
SOCKETIO_HOST=0.0.0.0
